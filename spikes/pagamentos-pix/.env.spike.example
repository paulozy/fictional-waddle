# Credenciais do spike de pagamentos. Copie para `.env.spike` (gitignored pelo
# padrão `.env*` da raiz) e preencha.
#
# Deliberadamente FORA do `.env.example` do projeto: aquele arquivo documenta o
# env do produto, e este spike pode ser descartado — listá-lo lá afirmaria que a
# feature existe.

# Painel do MP → Suas integrações → sua aplicação → Credenciais de produção.
# São da aplicação (nós), não do vendedor.
MP_CLIENT_ID=
MP_CLIENT_SECRET=

# Precisa ser IDÊNTICA à cadastrada em Detalhes da aplicação → Editar dados →
# Configurações avançadas → "URLs de redirecionamento". O MP recusa se divergir em
# qualquer caractere.
#
# **HTTPS é obrigatório** (o painel descreve o campo como "URLs (em https)"), então
# `http://localhost` não serve e o túnel é pré-requisito desde o primeiro passo.
# Ponha aqui a URL pública do túnel e aponte o túnel para PORTA_LOCAL.
#   MP_REDIRECT_URI=https://algo.ngrok-free.app/oauth/callback
MP_REDIRECT_URI=

# Só quando MP_REDIRECT_URI for pública (túnel): em que porta local escutar.
# Default 8788.
PORTA_LOCAL=

# Painel do MP → Suas integrações → sua aplicação → Webhooks → assinatura secreta.
# É o segredo do HMAC do header `x-signature`.
MP_WEBHOOK_SECRET=

# Porta local do receptor de webhook (4-webhook.mjs). Default 8789.
PORTA_WEBHOOK=

# E-mail do pagador de teste na criação da cobrança. Opcional.
MP_EMAIL_PAGADOR=
