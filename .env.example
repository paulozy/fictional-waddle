# Supabase — projeto e chaves
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Nunca prefixar com NEXT_PUBLIC_: ignora RLS, uso restrito a cron e webhook
SUPABASE_SERVICE_ROLE_KEY=

# Evolution API (self-hosted, pinada na 2.3.7 — a 2.4.0 exige ativação de licença)
EVOLUTION_API_URL=
EVOLUTION_API_ADMIN_KEY=

# Segredo enviado pela Vercel no header Authorization do cron
CRON_SECRET=

# Segredo que registramos no header da instância Evolution e validamos no webhook.
# O [instance] da URL é um UUID, não um segredo — este header é a autenticação real.
WEBHOOK_SECRET=

# URL pública do site, com protocolo e sem barra final. Alimenta o
# `metadataBase`, o `canonical` de cada página, o `og:url` e o sitemap.
# Vazia = cai em VERCEL_PROJECT_PRODUCTION_URL (o alias estável do projeto) e,
# fora da Vercel, em http://localhost:3000. Nunca lança: `metadataBase` é
# avaliado em tempo de módulo, e exigir a var quebraria o build.
#
# Deixada vazia de propósito enquanto `encaixaria.com.br` NÃO está registrado
# (situação em 2026-07-30): o fallback faz a produção se anunciar pelo alias
# estável da Vercel, que é um endereço que de fato resolve. Preencher com o
# domínio próprio no dia do registro — antes disso, `canonical`, `og:url` e
# sitemap apontariam todos para um domínio inexistente.
#   SITE_URL=https://encaixaria.com.br
SITE_URL=

# Token da meta tag de verificação do Google Search Console (só o valor do
# `content`, não a tag inteira). Vazia = a tag não é emitida.
# Obtido em https://search.google.com/search-console ao adicionar a propriedade.
GOOGLE_SITE_VERIFICATION=

# Endereço em que a Evolution API alcança ESTE app — não é a URL que você abre
# no navegador. Em produção, a URL pública da Vercel.
# Em dev depende de onde a Evolution roda:
#   - container Docker na mesma máquina: o gateway da rede dela
#     (`docker exec <container> ip route | grep default`), ex http://172.20.0.1:3000
#   - Evolution remota: precisa de túnel (ngrok/cloudflared), porque localhost
#     não é alcançável de fora
WEBHOOK_BASE_URL=

# Guarda de teste: se preenchida, o bot atende SOMENTE estes remetentes.
# Vazia (default) = atende todos, que é o comportamento de produção.
# Serve para parear um número pessoal sem responder a contatos reais.
# Aceita número solto ou JID completo, separados por vírgula:
#   BOT_JIDS_PERMITIDOS=5511999998888,5511977776666@s.whatsapp.net
BOT_JIDS_PERMITIDOS=

# Segredo usado no HMAC do número de WhatsApp gravado em `trials_numero_whatsapp`
# (um trial por número). Nunca no banco: o espaço de telefones brasileiros é
# pequeno, e sem pepper um hash puro seria reversível por força bruta.
#   TRIAL_HASH_PEPPER=$(openssl rand -hex 32)
# ATENÇÃO: trocar este valor invalida o livro-caixa inteiro — todos os hashes já
# gravados deixam de casar e todo mundo ganha um trial novo.
# Vazia = a reivindicação é PULADA (ninguém é bloqueado) e o webhook loga erro.
TRIAL_HASH_PEPPER=

# Número de contato para onde o banner de assinatura manda o dono (link wa.me).
# Não há gateway nesta fase: a assinatura é combinada por aqui e o
# `perfis.status_assinatura` é virado à mão para 'ativo'.
# Vazia = o banner aparece sem botão. Com DDI, só dígitos:
#   WHATSAPP_CONTATO=5511999998888
WHATSAPP_CONTATO=

# ---------------------------------------------------------------------------
# Cobrança de sinal por Pix (adicional).
#
# Tudo abaixo só é lido quando `perfis.plano = 'sinal'` E o dono conectou a
# conta dele. Vazias = a capacidade fica desligada e o bot agenda sem cobrar,
# que é o comportamento de todo tenant hoje.
#
# O modelo é NUNCA CUSTODIAR: o dono autoriza a própria conta por OAuth e o Pix
# cai direto nela. Dinheiro passando pela nossa conta seria conta bolsão, vedada
# pelo art. 90-A do Regulamento do Pix (Res. BCB 269/2022).
# ---------------------------------------------------------------------------

# Credenciais da aplicação no Mercado Pago (Suas integrações → sua aplicação).
# Exigem `offline_access` ligado nas permissões: sem ele o OAuth fecha mas NÃO
# vem `refresh_token`, e a conexão de cada tenant morre em 180 dias, em silêncio.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=

# Para onde o Mercado Pago devolve o dono depois de autorizar. Precisa estar
# cadastrada, IDÊNTICA, em "URLs de redirecionamento" no painel deles — o campo
# exige https, então em dev é túnel (ngrok/cloudflared), não localhost:
#   MERCADO_PAGO_REDIRECT_URI=https://seu-tunel/api/pagamentos/mercadopago/callback
MERCADO_PAGO_REDIRECT_URI=

# Segredo do webhook de pagamento, copiado do painel do Mercado Pago.
# Valida o HMAC de `x-signature`. Vazia = TODA notificação é recusada com 401
# (fail-closed): é o único portão daquele endpoint.
MERCADO_PAGO_WEBHOOK_SECRET=

# Chave AES-256-GCM que cifra os tokens do dono em `credenciais_pagamento`.
# Esses tokens movimentam conta bancária de terceiro — é o segredo mais sensível
# do projeto, acima da EVOLUTION_API_ADMIN_KEY.
#   PAGAMENTO_CRYPTO_KEY=$(openssl rand -hex 32)
# ATENÇÃO: trocar este valor invalida todas as conexões, e cada dono precisa
# reautorizar. Vazia = a cobrança falha e o agendamento segue SEM sinal.
PAGAMENTO_CRYPTO_KEY=

# Base da API do Mercado Pago. Vazia = https://api.mercadopago.com (produção).
# Existe para o teste ponta a ponta apontar para um stub local, sem credencial
# real e sem tocar em nenhum .env do projeto.
MERCADO_PAGO_API_URL=
